{
    "name": "mmalessa/pizzeria",
    "description": "Pizzeria - a DDD architectural sandbox",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "symfony/framework-bundle": "^8.1",
        "symfony/console": "^8.1",
        "symfony/yaml": "^8.1",
        "spiral/roadrunner-http": "^4.1",
        "spiral/roadrunner-jobs": "^4.7",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "symfony/psr-http-message-bridge": "^8.1",
        "justinrainbow/json-schema": "^6.2",
        "ramsey/uuid": "^4.7",
        "monolog/monolog": "^3.9",
        "symfony/var-exporter": "8.1.1"
    },
    "autoload": {
        "psr-4": {
            "Pizzeria\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
